[Unit]
Description=Story Phone recording booth
After=sound.target network.target

[Service]
Type=simple
# Replace YOUR_USER with the Linux user on the Pi, and adjust the path
# if you cloned the project somewhere other than your home directory.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/story-phone
ExecStart=/usr/bin/python3 /home/YOUR_USER/story-phone/storyphone.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
